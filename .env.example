# =============================================================================
# QuMail Environment Configuration
# Copy this file to .env in the backend/ directory and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Server
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL — started via docker-compose up)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://qumail:qumail@localhost:5432/qumail

# -----------------------------------------------------------------------------
# Authentication — JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_HEX_CHARS

# -----------------------------------------------------------------------------
# Google OAuth 2.0 (Gmail)
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
# 5. Enable: Gmail API (https://console.cloud.google.com/apis/library/gmail.googleapis.com)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# Microsoft OAuth 2.0 (Outlook / Microsoft 365)
# 1. Go to https://portal.azure.com/ → Azure Active Directory → App registrations
# 2. New registration → Web platform → Redirect URI: http://localhost:3000/api/auth/microsoft/callback
# 3. Certificates & secrets → New client secret
# 4. API permissions → Add: Mail.Read, Mail.Send, Mail.ReadWrite, User.Read, offline_access
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# -----------------------------------------------------------------------------
# Pinata IPFS (Attachment Storage)
# 1. Go to https://app.pinata.cloud/
# 2. API Keys → New Key → Admin → Copy the JWT
# When not set: the system uses an in-memory mock IPFS store (dev only).
# -----------------------------------------------------------------------------
PINATA_JWT=

# -----------------------------------------------------------------------------
# Blockchain (Local Hardhat Node — no real ETH needed)
# 1. Start: cd blockchain && npx hardhat node
# 2. Deploy: npx hardhat run scripts/deploy.ts --network localhost
# 3. Copy the printed contract address below.
# REGISTRY_DEPLOYER_PRIVATE_KEY: use any key from Hardhat's test accounts (printed on node start)
# When not set: the system uses a mock blockchain registry (dev only).
# -----------------------------------------------------------------------------
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
REGISTRY_CONTRACT_ADDRESS=
REGISTRY_DEPLOYER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# AI / ML Sidecar (Python FastAPI)
# 1. cd ml && python startup.py
# When the sidecar is not running, the system falls back to rule-based TypeScript detection.
# -----------------------------------------------------------------------------
ML_SIDECAR_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Quantum Key Manager
# Initial in-memory pool size in bytes (default = 10 MB = 10,485,760 bytes)
# -----------------------------------------------------------------------------
QKM_INITIAL_POOL_BYTES=10485760

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
